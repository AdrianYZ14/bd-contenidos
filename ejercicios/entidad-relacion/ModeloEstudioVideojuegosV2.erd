erdiagram ModeloEstudioVideojuegos
notation=crowsfoot
entity Desarrollador {
    dni key
    cuenta_bancaria unique
    sueldo
    especialidad
    nombre
    apellido_1
    apellido_2
}
entity Equipo {
    codigo key
    nombre unique
}
entity Videojuego {
    codigo key
    titulo unique
    argumento
}
weak entity Nivel {
    numero partial-key
    nombre
    dificultad
    duracion_estimada
}
weak entity Sede {
    ciudad partial-key
    direccion
}
relationship pertenece_a{
    Desarrollador [0..N] -> Equipo [1..1]
}
relationship lidera{
    Desarrollador [0..1] -> Equipo [0..1]
    fecha_inicio_lider
}
relationship desarrolla{
    Videojuego [0..N] -> Equipo [1..1]
}
weak relationship forma_parte_de{
    Videojuego [1..1] -> Nivel [0..N]
}
weak relationship tiene_sede {
    Equipo[1..1] -> Sede[1..N]
}
relationship trabaja_en{
    Videojuego [0..N] -> Desarrollador [0..N]
    horas
}
relationship mentoriza{
    Desarrollador [0..1 | "Mentor"] -> Desarrollador [0..N | "Mentorizado"]
}